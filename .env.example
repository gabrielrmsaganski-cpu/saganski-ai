# Provedor de IA do chat consultor (opcional). Atualmente suportado: openai
AI_PROVIDER=openai

# Chave do provedor (opcional). Sem esta variável o chat usa um fallback consultivo offline.
OPENAI_API_KEY=

# Modelo OpenAI (opcional). Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Webhook para receber leads/briefings (opcional). Sem ele, leads são salvos em localStorage no browser.
LEADS_WEBHOOK_URL=
